# Dependencies
**/node_modules
.pnpm-store/

# Build outputs
dist/
build/
*.dist

# Local tooling config (often contains secrets; use .project-config.example.json as a template)
.project-config.json

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Gatsby files
.cache/

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Webdev artifacts (checkpoint zips, migrations, etc.)
.webdev/

# Manus version file (auto-generated, not part of source)
client/public/__manus__/version.json

# Claude Code agent worktrees (ephemeral, contain node_modules — 1.4GB+)
.claude/worktrees/

# ---------------------------------------------------------------------------
# 에이전트 산출물 — 리포에 남기지 않는다
#
# 이 리포는 public이다. 일일 지시서에는 아직 안 고친 결함의 위치가 파일:줄 단위로
# 들어간다(보안 항목 포함). 비밀값 자체는 애초에 쓰지 않게 되어 있지만,
# **위치 목록 자체가 약점 지도**다. 공개된 곳에 매일 쌓이면 안 된다.
#
# 그래서 지시서는 러너 안에서만 만들어져 Slack #request로 나가고,
# 러너와 함께 사라진다. git에는 어떤 흔적도 남지 않는다.
# 이력이 필요하면 Slack 채널이 그 이력이다.
reports/
company/

# 조사 중 만든 임시 산출물 (재현 케이스, 로그 덤프, 패치 파일)
*.patch
scratch/
.agent-tmp/
